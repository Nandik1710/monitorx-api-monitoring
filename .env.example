NODE_ENV=development
APP_VERSION=0.1.0
API_PORT=4000
WORKER_PORT=4100
WEB_PORT=5173
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000
DATABASE_URL=postgresql://monitorx:local_development_only@localhost:5432/monitorx?schema=public
REDIS_URL=redis://localhost:6379
MAILPIT_SMTP_URL=smtp://localhost:1025
MAILPIT_WEB_URL=http://localhost:8025
AUTH_MAIL_FROM=no-reply@monitorx.local
GITHUB_OAUTH_ENABLED=false
# Only add these to your local .env when enabling GitHub:
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Replace these placeholders only in an untracked local .env file.
# Opaque sessions use random tokens with database hashes; SESSION_SECRET is not used.
TENANT_KEY_PROVIDER=local
TENANT_ENCRYPTION_KEY_VERSION=1
TENANT_ENCRYPTION_CONTEXT=monitorx:environment-secret
# Required for secret writes: private JSON map of version -> 32-byte base64 key.
# Set TENANT_ENCRYPTION_KEYS only in your untracked local environment; never print it.
# KMS_KEY_ID is reserved for an injected deployment KeyProvider (no AWS calls locally).
