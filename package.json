{
  "name": "monitor-x",
  "version": "0.1.0",
  "private": true,
  "description": "Monitor-X API testing and reliability monitoring platform",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.15.0 <25"
  },
  "scripts": {
    "secrets:init": "node scripts/init-tenant-key.mjs",
    "prebuild": "pnpm db:generate",
    "predev": "pnpm db:generate && pnpm --filter @monitorx/api^... --filter @monitorx/worker^... build && pnpm --filter @monitorx/ui build",
    "pretypecheck": "pnpm db:generate && pnpm --filter @monitorx/api^... --filter @monitorx/worker^... build && pnpm --filter @monitorx/ui build",
    "pretest": "pnpm db:generate && pnpm --filter @monitorx/api^... --filter @monitorx/worker^... build && pnpm --filter @monitorx/ui build",
    "pretest:integration": "pnpm db:generate && pnpm --filter @monitorx/api^... --filter @monitorx/worker^... build",
    "build": "pnpm --recursive --if-present build",
    "db:generate": "pnpm --filter @monitorx/db db:generate",
    "db:migrate": "pnpm --filter @monitorx/db db:migrate",
    "db:migrate:dev": "pnpm --filter @monitorx/db db:migrate:dev",
    "db:seed": "pnpm --filter @monitorx/db db:seed",
    "dev": "concurrently --kill-others-on-fail \"pnpm --filter @monitorx/api dev\" \"pnpm --filter @monitorx/worker dev\" \"pnpm --filter @monitorx/web dev\"",
    "format": "prettier --write \"**/*.{js,mjs,cjs,json,yaml,yml,ts,tsx,css,html,md}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs,json,yaml,yml,ts,tsx,css,html,md}\"",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:integration": "cross-env RUN_INTEGRATION=true vitest run tests/integration",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@prisma/client": "6.1.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.1.0",
    "@types/node": "22.10.5",
    "@types/supertest": "6.0.2",
    "@types/ws": "8.18.1",
    "concurrently": "9.1.2",
    "cross-env": "7.0.3",
    "eslint": "9.17.0",
    "ioredis": "5.4.1",
    "jsdom": "25.0.1",
    "prettier": "3.4.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router-dom": "7.18.4",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.0",
    "vitest": "2.1.8",
    "ws": "8.22.0"
  }
}
